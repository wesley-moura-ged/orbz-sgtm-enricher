# Image used by the Portainer stack after the GitHub repository is renamed.
ORBZ_ENRICHER_IMAGE=ghcr.io/wesley-moura-ged/orbz-sgtm-enricher:latest
ORBZ_GEOIP_UPDATER_IMAGE=ghcr.io/wesley-moura-ged/orbz-sgtm-enricher:geoip-updater

# Public overlay network used by Traefik in the current Swarm environment.
TRAEFIK_NETWORK=network_swarm_public
